# Supabase
SUPABASE_URL=https://tuo-progetto.supabase.co
# Crawler / server: service_role (mai nell'app mobile)
SUPABASE_KEY=la_tua_service_role_key
# App login (auth/agropocket_auth.py): solo anon public
SUPABASE_ANON_KEY=la_tua_anon_public_key

# Provider embedding: "openai" oppure "gemini"
EMBEDDING_PROVIDER=openai
API_KEY=sk-...

# Solo se usi OpenAI (opzionale, default text-embedding-3-small)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Solo se usi Gemini (opzionale)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Meteo (onboarding + analisi) — OpenWeather
OPENWEATHER_API_KEY=
